{
  "openapi": "3.1.0",
  "info": {
    "title": "SpecForge Sample Store API",
    "description": "Sample FastAPI service verifying specforge-api (PyPI) interactive docs and contract fuzzing.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Service liveness probe.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create User",
        "description": "Create a user with strict schema and boundary validation.",
        "operationId": "create_user_api_v1_users_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "List Users",
        "description": "List or filter registered users.",
        "operationId": "list_users_api_v1_users_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 50,
              "description": "Search filter (or 'all' to return all users)",
              "default": "all",
              "title": "Q"
            },
            "description": "Search filter (or 'all' to return all users)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Maximum number of users to return",
              "default": 10,
              "title": "Limit"
            },
            "description": "Maximum number of users to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserResponse"
                  },
                  "title": "Response List Users Api V1 Users Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{user_id}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get User",
        "description": "Fetch a single user by UUID.",
        "operationId": "get_user_api_v1_users__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create Order",
        "description": "Create an order with numeric, array, UUID, and timestamp validation.",
        "operationId": "create_order_api_v1_orders_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderCreate": {
        "properties": {
          "customer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Customer Id",
            "description": "Customer UUID",
            "examples": [
              "123e4567-e89b-12d3-a456-426614174000"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 80,
            "minLength": 2,
            "title": "Title",
            "description": "Order label",
            "examples": [
              "Starter Pack"
            ]
          },
          "unit_price": {
            "type": "number",
            "maximum": 10000.0,
            "minimum": 0.01,
            "title": "Unit Price",
            "description": "Unit price in USD",
            "examples": [
              29.99
            ]
          },
          "quantity": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity",
            "description": "Order quantity",
            "examples": [
              2
            ]
          },
          "tags": {
            "items": {
              "type": "string",
              "maxLength": 150,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "uniqueItems": true,
            "title": "Tags",
            "description": "Unique non-empty tags for the order",
            "examples": [
              [
                "priority",
                "api"
              ]
            ]
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "title": "Scheduled At",
            "description": "ISO-8601 fulfillment timestamp",
            "examples": [
              "2026-11-15T10:00:00Z"
            ]
          },
          "expedited": {
            "type": "boolean",
            "title": "Expedited",
            "description": "Whether expedited shipping is enabled",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_id",
          "title",
          "unit_price",
          "quantity",
          "tags",
          "scheduled_at"
        ],
        "title": "OrderCreate",
        "description": "Payload for creating an order (exercises floats, arrays, UUIDs, and timestamps)."
      },
      "OrderResponse": {
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid",
            "title": "Order Id"
          },
          "customer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Customer Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "total_amount": {
            "type": "number",
            "title": "Total Amount"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags"
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "title": "Scheduled At"
          },
          "expedited": {
            "type": "boolean",
            "title": "Expedited"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "customer_id",
          "title",
          "unit_price",
          "quantity",
          "total_amount",
          "tags",
          "scheduled_at",
          "expedited"
        ],
        "title": "OrderResponse",
        "description": "Response schema for created orders."
      },
      "UserCreate": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 24,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_.-]+$",
            "title": "Username",
            "description": "Unique username (3-24 alphanumeric, underscore, dot, or hyphen chars)",
            "examples": [
              "alice_dev"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Contact email address",
            "examples": [
              "alice@example.com"
            ]
          },
          "age": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 18.0,
            "title": "Age",
            "description": "User age in years (18-120)",
            "examples": [
              28
            ]
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "description": "Assigned user role",
            "default": "member"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "description": "Whether the account is active",
            "default": true
          },
          "website": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website",
            "description": "Optional personal website URL",
            "examples": [
              "https://example.com"
            ]
          },
          "bio": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 150,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio",
            "description": "Optional short biography",
            "examples": [
              "API developer"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "email",
          "age"
        ],
        "title": "UserCreate",
        "description": "Payload for creating a user account."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "age": {
            "type": "integer",
            "title": "Age"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          },
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "age",
          "role",
          "is_active",
          "created_at"
        ],
        "title": "UserResponse",
        "description": "Response schema returned for user operations."
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "member",
          "admin",
          "viewer"
        ],
        "title": "UserRole"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
